{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STM32 调试 (OpenOCD + ST-LINK)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/Debug/project.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "D:\\STM32Cube\\VSCodeBundles\\gnu-tools-for-stm32\\14.3.1+st.2\\bin\\arm-none-eabi-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "setupCommands": [
        {
          "description": "连接 OpenOCD GDB 服务器",
          "text": "target extended-remote localhost:3333",
          "ignoreFailures": false
        },
        {
          "description": "复位并停在入口",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "烧录当前固件",
          "text": "load",
          "ignoreFailures": false
        },
        {
          "description": "复位到 main 入口",
          "text": "monitor reset init",
          "ignoreFailures": false
        },
        {
          "description": "继续运行",
          "text": "continue",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "STM32: 启动 OpenOCD GDB 服务器",
      "stopAtEntry": false,
      "externalConsole": false,
      "logging": {
        "engineLogging": false
      }
    }
  ]
}
